#!/usr/bin/env bash

set -eu -o pipefail

real_tmp=$(readlink -f /tmp)

if [[ "${HOME%/}"/ == "${PWD%/}"/* || "${real_tmp%/}/" == "${PWD%/}"/* ]]; then
	mkdir -p "${XDG_RUNTIME_DIR:?}"/bwrap-node-copilot
	cd "${XDG_RUNTIME_DIR:?}"/bwrap-node-copilot
fi

copilot_language_server=$(mise which copilot-language-server)

mkdir -p \
	~/.cache/Microsoft/DeveloperTools \
	~/.config/github-copilot \
	~/.copilot \
	#

exec bwrap-home \
	--home-tmpfs --tmpfs \
	--mount-rw ~/.cache/Microsoft/DeveloperTools \
	--mount-rw ~/.config/github-copilot \
	--mount-rw ~/.copilot \
	-- \
	"$copilot_language_server" "$@"
